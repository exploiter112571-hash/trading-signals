+// and the endpoint returned 0 aircraft). Every region is clamped to this.
+const MAX_RADIUS_NM = 250;
+
 const REGIONS = [
   { lat: 39.8, lon: -98.5, dist: 2000 },   // North America
   { lat: 50.0, lon: 15.0, dist: 2000 },     // Europe
@@ -14,7 +19,13 @@ const REGIONS = [
   { lat: -25.0, lon: 133.0, dist: 2000 },   // Australia
   { lat: 0.0, lon: 20.0, dist: 2500 },      // Africa
   { lat: -15.0, lon: -60.0, dist: 2000 },   // South America
-];
+  // Gulf / Strait of Hormuz (local addition for the trading-signals pipeline):
+  // four 250 NM tiles that fully cover lat 22-30, lon 48-58.
+  { lat: 24.0, lon: 50.5, dist: 250 },
+  { lat: 28.0, lon: 50.5, dist: 250 },
+  { lat: 24.0, lon: 55.5, dist: 250 },
+  { lat: 28.0, lon: 55.5, dist: 250 },
+].map(r => ({ ...r, dist: Math.min(r.dist, MAX_RADIUS_NM) }));
 
 // Helicopter type codes
 const HELI_TYPES = new Set([
@@ -58,12 +69,18 @@ async function fetchRegion(region: typeof REGIONS[0]): Promise<any[]> {
     const url = `https://api.adsb.lol/v2/lat/${region.lat}/lon/${region.lon}/dist/${region.dist}`;
     const res = await fetch(url, {
       signal: AbortSignal.timeout(12000),
-      headers: { 'Accept': 'application/json' },
+      headers: {
+        'Accept': 'application/json',
+        'User-Agent': 'OSIRIS-local-test/1.0 (+https://github.com/aiacos/osiris)',
+      },
     });
     if (res.ok) {
       const data = await res.json();
       return data.ac || [];
     }
+    // Previously non-OK responses were dropped silently, which hid the
+    // 250 NM limit change entirely.
+    console.warn(`Region fetch HTTP ${res.status} for lat=${region.lat} lon=${region.lon}: ${(await res.text()).slice(0, 120)}`);
   } catch (e) {
     console.warn(`Region fetch failed for lat=${region.lat}:`, e);
   }
