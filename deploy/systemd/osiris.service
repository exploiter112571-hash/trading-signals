[Unit]
Description=osiris (local OSINT API server for pipeline poller)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/osiris-src
ExecStart=/home/roboslayer777/.nvm/versions/node/v24.19.0/bin/node %h/osiris-src/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
