[Unit]
Description=opensky_poller (continuous background poller)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@DATA_DIR@
Environment=PIPELINE_DATA_DIR=@DATA_DIR@
ExecStart=@PYTHON@ @PIPELINE_DIR@/scripts/opensky_poller.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
